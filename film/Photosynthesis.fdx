    <Paragraph Type="Character" id="763ca795-6756-4aa7-ab1a-fcc2feb71658">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6a20f945-c85a-4c57-97d0-3c5c4be7cf4b">
