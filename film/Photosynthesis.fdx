      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b40cd17f-a83a-4d83-ac8e-0dde9da86012">
      <Text>Malus is my </Text>
      <Text AdornmentStyle="-1">unty</Text>
      <Text>! Ugh. You’re good as dirt, hanging with the grapes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="053622d8-cc77-4615-ba96-b22700d9befd">
