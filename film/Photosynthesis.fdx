    <Paragraph Type="Character" id="4099b22c-191f-49d7-ba23-11810153691b">
      <Text>Parsley &amp; Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="161d7d8c-b60e-4bf5-aec0-6bd543469c98">
      <Text Style="AllCaps">Root for me
and water me!</Text>
