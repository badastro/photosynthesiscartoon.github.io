    <Paragraph Type="Dialogue" id="9c85762a-348f-4be8-97fc-f5a15efa19dd">
      <Text Size="8">
</Text>      <Text Style="AllCaps">Do not mess around because my roots are in da underground.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c8784e7-c2e2-472c-bacb-06f835dc9987">
      <Text Style="AllCaps">Now you’ve stuck around, we’ll have your stems impound </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">impound</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">impound</Text>
