          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Int. Trunk Miniwagon - Continuous</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9635b189-1d31-4639-9ed6-d421437c4643">
      <Text Style="AllCaps">Rau Ram</Text>
      <Text> (36), a cilantro, drives. Her son </Text>
      <Text Style="AllCaps">Parsley</Text>
      <Text> (11), pear friend </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> (13), and antsy pet bee </Text>
      <Text Style="AllCaps">Bombus</Text>
      <Text> sit in the back.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fb738352-9b6b-49db-9ff1-e88c9ed43713">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49daa453-4d23-46f6-9fda-38f6c638e1b4">
      <Text>We are almost at </Text>
      <Text AdornmentStyle="-1">Freshhh</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">Groundddd</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0958ac0b-dd83-42d0-b873-e0670874e853">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b8e243f6-93be-4dc8-b73e-5bf458e30a89">
      <Text>Ya supposed to save me from</Text>
      <Text Size="10"> </Text>
      <Text>military school, not send us to boot camp!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9beb8f17-9218-4130-83c6-8f99c7f1f3a4">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="82bffa67-ba5a-4a0c-988f-d5d0ba8fcc34">
      <Text>Fresh Ground’s an </Text>
      <Text Style="Italic">artist</Text>
      <Text> boot camp. The best inventors, entrepreneurs, </Text>
      <Text Style="Italic">musicians</Text>
      <Text> come out of the program. But Kudzu’s a fellow camper, ugh...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fcd724e0-f7b2-4541-a8fe-8f378daddbde">
      <Text>Parsley</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="358c12e5-685d-423a-a6e7-a954966ef287">
      <Text>To think plants call you invasive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e0924e8e-49e9-4d29-bd72-864c604f495f">
      <Text>PyrUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9578831b-36f2-428c-a96e-24e9eb0a4693">
      <Text>Hah. Dis camp’s for you, nerd herb.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5b38caaa-2c22-4e51-9bd3-a4b9ee01bc9a">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bb9ac824-0cfe-4c27-9757-c5afa0ddd0eb">
      <Text AdornmentStyle="-1">Oci</Text>
      <Text> will be your chaperone.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="ba61e3aa-0413-4984-9e5b-8af3dc9ce7fb">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="41f3d6ed-6f54-4259-bc6e-7bf6a24e2ae2">
          <Text>Parsley</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="4439f909-b411-4de9-9b10-a00463fd66af">
          <Text AdornmentStyle="-1">Whoo</Text>
          <Text>! </Text>
          <Text AdornmentStyle="-1">Oci’s</Text>
          <Text> everywhere!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="bdb10c9d-f27a-4813-8452-2903f07fa038">
          <Text>Pyrus</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="afe2f142-c80d-4051-87bc-bb9f322b7437">
          <Text>Ugh! That basil’s there too?!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="04d55ef4-af02-4d0a-b636-be7f58adecaa">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="06965424-3f23-446e-91f7-c0d1f800cfde">
      <Text>Why ain’t ya be our chaperone?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f43e7a88-3686-4e54-b7fb-1841d4b42313">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a079a042-2b44-4698-a342-abe1001dd1f6">
      <Text>That’s the first. I’ve got my own.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1836ba11-f5c9-4c67-a3fd-d32105fce24d">
      <Text>Parsley</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b9c06308-fb30-4064-92cb-94d063026e6c">
      <Text>Mom. You’re gonna crush whatever obstacle they’ll pepper you with.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="051f18a0-1357-464f-8b64-93edd26e2117">
      <Text>RAU</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="398f0e7e-b498-4993-9cc2-93c512a89575">
      <Text>I will crush this boot camp!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Scene Heading" id="e5d96d4e-611f-4ea9-a38e-83d7b7b378c6">
      <SceneProperties Length="7/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CAMPERS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PIPER BELL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TOM SOLAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Fresh Ground Trail</Text>
    </Paragraph>
    <Paragraph Type="Action" id="916da9d4-3e48-4754-81f2-47f904bad32f">
      <Text Style="AllCaps">Rau</Text>
      <Text> falls face first into mud. </Text>
      <Text Style="AllCaps">Kudzu</Text>
      <Text>’s boots trample her.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c14bc6d0-6884-452a-b00a-4e1ff6b1c3d6">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="df321004-c24a-415c-8169-f914dc0a13c1">
      <Text>Boots... crushing... </Text>
      <Text AdornmentStyle="-1">meeeeee</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0ae3681e-eee3-4530-aa21-3086aaead6b0">
      <Text>PiPER BELL (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e232ab92-8707-4998-9c4c-521ab1fbfa33">
      <Text>Ding dong! Get a move on, cilantro.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cac575fd-fd3e-410a-b3ee-cca2323f6a14">
      <Text Style="AllCaps">Rau</Text>
      <Text> sees </Text>
      <Text Style="AllCaps">Tom Solan</Text>
      <Text>, a tomato, spill their sauce.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b1cc1d28-a8ef-43e6-87b3-5faa20fe7793">
      <Text>PipeR BELL (o.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3ae4ae7b-9a14-45a4-a324-906f93d25c6e">
      <Text>Tom Solan, pick up after ya sauce!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="60a8ca7c-2c77-4232-adad-128afb64d569">
      <Text>Tom Solan</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="2dfb1634-5e78-4b22-9122-cb9f29099937">
      <Text>(to </Text>
      <Text Style="AllCaps">Rau</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8efbc057-0ae8-4f29-96c9-1a7d819dbbcb">
      <Text>These peppers always getting up in our noses, amirite?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9c79bde1-066a-46c4-a571-257b4afea3a0">
      <Text Style="AllCaps">Piper Bell, </Text>
      <Text>a peppered drill instructor in their 60s, leads a group of exhausted </Text>
      <Text Style="AllCaps">plants</Text>
      <Text>. </Text>
      <Text Style="AllCaps">Rau</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Tom</Text>
      <Text> trail behind.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="440d2d42-177b-4664-a22a-2ba029532c96">
      <Text>Piper Bell</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1c04d5f4-2727-428a-8d5d-1c2a5ddedaca">
      <Text Style="AllCaps">I don’t know but I've been told</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e47fc901-b6c9-4548-bb47-98eef2765b0e">
      <Text>Campers</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ef77e8ee-9878-4ec1-97ad-dd957fc0884d">
      <Text Style="AllCaps">I don’t know but I've been told</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1acce8c4-7830-465a-9eb4-32ea6e656907">
      <Text>Piper BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a0c31783-1cd9-430f-9142-3eea97ce77ad">
      <Text Style="AllCaps">hopes and dreams are full of mold</Text>
    </Paragraph>
    <Paragraph Type="Character" id="47443b79-85bf-4256-b53a-3dfe38aa21ec">
      <Text>Campers</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="67397ade-5c1d-4890-87b6-86420501191b">
      <Text Style="AllCaps">Hopes and dreams are full of mold</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="b8ee82d0-209a-4176-94ca-d33e6a56d1b1">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="7f1411cb-947c-42e5-9ada-3a70089de5d1">
          <Text>Piper Bell</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="8311ea6f-5e59-4117-a7e2-1c191b292975">
          <Text Style="AllCaps">You’re flat</Text>
        </Paragraph>
        <Paragraph Type="Character" id="22c2a35c-4009-4bc2-81f6-dedbd3caad22">
          <Text>Campers</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="112257b5-698c-4e1b-ae13-572e21711edc">
          <Text Style="AllCaps">Do re</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="d18a8908-1012-4152-8d72-302fe12edcaf">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="e97227b8-d3cf-40b3-b018-7bd78de76f28">
          <Text>PipER BELL</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="c7930921-2a5f-4037-a63c-51957d2af7c4">
          <Text Style="AllCaps">You’re sharp</Text>
        </Paragraph>
        <Paragraph Type="Character" id="22c2a35c-4009-4bc2-81f6-dedbd3caad22">
          <Text>Campers</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="c57aa5fc-b83c-45f5-b1b3-5f827d9a23ab">
          <Text Style="AllCaps">mi fa</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="cecdfa77-8969-4d66-a542-ca477410f926">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="7f1411cb-947c-42e5-9ada-3a70089de5d1">
