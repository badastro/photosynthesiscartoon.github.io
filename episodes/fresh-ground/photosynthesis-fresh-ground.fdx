          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. </Text>
      <Text AdornmentStyle="-1" Style="Bold+AllCaps">WhiskerSkIlls</Text>
      <Text Style="Bold+AllCaps"> - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1eaabb0d-4b45-4d64-8a02-17e468d29087">
      <Text>A tree trunk-shaped van drives up unpaved trails through a giant mushroom forest. Behind the van is a sticker that reads: “Accepted to Fresh Ground Creative Boot Camp.”</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="5110ba83-2985-486c-a746-6a2de33cb123">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="c0618df4-8fa3-4e04-b30b-96e84f083d48">
          <Text>Bombus (O.S.)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="dc96f5c3-8946-4994-8d23-524664889ce2">
          <Text AdornmentStyle="-1">Buzzzzzzzzzzzzzzzzzzzz</Text>
          <Text>...</Text>
        </Paragraph>
        <Paragraph Type="Character" id="bd8e7b9f-309f-4eac-a0f4-29c6a34f37a8">
          <Text>Rau (O.S.)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="afae519c-8e8b-49b2-a3c0-228e2b80b20a">
          <Text>No puking honey!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="d1c52fbf-635d-4077-8d45-9dcd1fc161bd">
      <Text>Pyrus (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49f4df82-c23a-4211-9974-94f213de9546">
      <Text>Ya just vomited at the pit stop!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Scene Heading" id="403914f1-b9de-4b34-87c2-a106b20998ff">
      <SceneProperties Length="7/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
