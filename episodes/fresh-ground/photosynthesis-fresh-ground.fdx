          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ZEA MAYS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Fresh Ground Campground - continUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3db36ece-68fd-46fe-bfcf-dc5b964060a0">
      <Text>...the campground. </Text>
      <Text Style="AllCaps">Bombus</Text>
      <Text> chills on the flagpole.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c750e15-90d3-4017-9f55-e8804a6d870e">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="23572550-6dd4-42b6-95fa-059f692ca9b9">
      <Text>Bombus, where are </Text>
      <Text AdornmentStyle="-1">Oci</Text>
      <Text> and the kids?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4798e76e-989f-48fb-ab40-90991b62d835">
      <Text Style="AllCaps">Bombus</Text>
      <Text> directs an antenna to a nearby creek. </Text>
      <Text Style="AllCaps">Rau</Text>
      <Text> sees </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> dive in and splash </Text>
      <Text Style="AllCaps">Parsley</Text>
      <Text> while </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Oci</Text>
      <Text> float on their back.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="af0beadd-86bc-468d-80c2-e73d9884fad9">
      <Text AdornmentStyle="-1">Oci</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba0f8720-3c78-475b-835f-d5445a36ddb3">
      <Text>Fresh Ground got some fresh water!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="710afb88-7648-453e-87af-12f9c9cd1c99">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="4706ff0c-5a51-4c67-af0b-16899e74a429">
          <Text>ParslEY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="58b5306c-5668-4704-8c42-c3425214efac">
          <Text>So campy, </Text>
          <Text AdornmentStyle="-1">Oci</Text>
          <Text>. Stop it, </Text>
          <Text AdornmentStyle="-1">Py</Text>
          <Text>-</Text>
        </Paragraph>
        <Paragraph Type="Character" id="f74fdd52-b601-4bd5-8c38-3c9fc43197d4">
          <Text>PyruS</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="eb35d50b-b2bf-4b99-b9ae-e0c72aa67576">
          <Text>I love boot camp!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="03032114-7ca2-4aad-bacf-044f487ce46f">
      <Text>Piper BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2aadc379-a1bf-4ef7-890c-f29e2014497d">
      <Text>No delighted listening. Ears on me!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9fdde305-7ce2-461f-baed-eace799718cd">
      <Text AdornmentStyle="-1" Style="AllCaps">Zea</Text>
      <Text Style="AllCaps"> Mays</Text>
      <Text>, a corn, lifts a peel. Kernels fall out their ears.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5ef7d81c-100f-4fc3-adaa-e5bd8994b312">
      <Text>PiPER BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2aa0b6cb-fe67-4f21-8085-e8ee3118e329">
      <Text>Easy with the kernels, corn ears.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe7a76ad-c8b8-419b-b257-dd9195a04393">
      <Text AdornmentStyle="-1">Zea</Text>
      <Text> Mays</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7f967cea-04a3-4fbb-9bbf-96ebed12a906">
      <Text>Ay </Text>
      <Text AdornmentStyle="-1">ay</Text>
      <Text>, Colonel Piper Bell!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4dd0d66d-397a-4c81-90dd-43c5905e2821">
      <Text>PipER BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="91c72cba-633e-4dc5-b25f-ce951cf6d2eb">
      <Text>Here at Fresh Ground, everyone gets grounded into spices. Say good night to your sweet dreams as this sour experience shall straighten your vine. Roots reshaped.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="085ea9bb-8c30-4aa7-81a0-9240dd949362">
      <Text>Kudzu </Text>
      <Text AdornmentStyle="-1">Lubata</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="41b8e77e-a7c0-4b95-a11a-e213a02ffa6f">
      <Text>You </Text>
      <Text AdornmentStyle="-1">needa</Text>
      <Text> get in shape.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6bf17cd1-6a7c-42ea-8d0c-4409c02d6118">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="efa5f5c4-c14a-4f90-afa2-5921415474db">
      <Text>Shut your sprout.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d4680ae-cc28-459c-a3c2-e60fdd998c41">
      <Text>Papa Ver</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6c5a19a0-b7c2-44ae-8e1e-277f5a63e879">
      <Text>At peas, Rau and </Text>
      <Text AdornmentStyle="-1">Kudz</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fa9afbfe-da9c-4e54-bb17-baa596ab3809">
      <Text>PipER BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75c84769-7000-428d-843d-466be26bf52c">
      <Text>At Fresh Ground, you only follow me, not this poppy.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Scene Heading" id="db8f9c74-cb7a-4729-9b95-ff0fbd23f74b">
      <SceneProperties Length="5/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="OCI">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY, PYRUS, OCI">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Fresh Ground Creek - continUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bc8ca5e7-cb41-40b4-aa27-d214b80dd4ef">
      <Text AdornmentStyle="-1" Style="AllCaps">Oci</Text>
      <Text> and the kids leave the creek. They take a selfie while </Text>
      <Text Style="AllCaps">Bombus</Text>
      <Text> buzzes in. </Text>
      <Text Style="Bold+Italic">Photosynthesis</Text>
      <Text> jingle!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a8a292c-c14a-40d9-ade5-60af68303797">
      <Text>Parsley, Pyrus, </Text>
      <Text AdornmentStyle="-1">Oci</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a2150d0f-2a6b-4bf9-a624-2f837fb9aeab">
      <Text Style="AllCaps">Photosynthesis</Text>
      <Text>! </Text>
      <Text Style="AllCaps">Photo!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4478b558-14fa-4212-b1f6-56462d7a0af3">
      <Text AdornmentStyle="-1" Style="AllCaps">Oci</Text>
      <Text>, </Text>
      <Text Style="AllCaps">Parsley</Text>
      <Text>, and </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> see </Text>
      <Text Style="AllCaps">Piper</Text>
      <Text> verbally rip apart </Text>
      <Text Style="AllCaps">Rau</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e328077-d74e-453e-ac2a-7af7c780e888">
      <Text AdornmentStyle="-1">Oci</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3bf0c855-a8d4-4e9d-be3e-1d7a47e7d592">
      <Text>She’s got a fun chaperone, huh?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="01f23e26-22ae-448c-ba56-b7497e998602">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7ad9e76a-1a6e-4750-be00-654955c145d2">
      <Text>Chaperoning? More like owning ya mom, Parsley.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dc61251a-72b9-4ca5-98a1-27fa27bc381f">
      <Text>Parsley</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f7986da-2ce5-43c2-bcf9-415d153e06ea">
      <Text>Shut up, Pyrus. Mom never lets me play in mud...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1cd87779-282e-4368-8472-eb51ba26a560">
      <Text Style="AllCaps">Piper</Text>
      <Text> and the </Text>
      <Text Style="AllCaps">campers</Text>
      <Text> leave </Text>
      <Text Style="AllCaps">Rau</Text>
      <Text> alone. Trying not to well up or smash a nearby pumpkin person, she turns to the </Text>
      <Text Style="AllCaps">kids</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f07f444-5545-41b1-8049-4878f2d3fca5">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="09c63441-621a-46cf-896e-8fb1a2df864c">
      <Text>The Firefly Pit tonight?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cacbb55e-884e-466b-8b5c-87b3a0b6b4db">
      <Text>A giant </Text>
      <Text Style="AllCaps">firefly</Text>
      <Text> flies over the frame and transitions to...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Scene Heading" id="dca21d98-2c85-4c8f-a905-0a5cea87f7e6">
      <SceneProperties Length="1/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Fresh Ground FireFly Circle - Evening</Text>
    </Paragraph>
    <Paragraph Type="Action" id="71c68a70-e101-463a-a202-1ae397c76601">
      <Text>...a </Text>
      <Text Style="AllCaps">marshmallow plant ranger</Text>
      <Text> herding </Text>
      <Text Style="AllCaps">fireflies</Text>
      <Text> into a pit. They give each </Text>
      <Text Style="AllCaps">bug</Text>
      <Text> a marshmallow. In return, they light up.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Scene Heading" id="d93c8c6c-3cdc-4c13-8c96-2592ed375589">
      <SceneProperties Length="1 1/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BELLA DONNA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BOMBUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="OCI">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY &amp; PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Fresh Ground FireFly Circle - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7b535217-ace7-417f-ad7a-2942e8e52b40">
      <Text Style="AllCaps">Rau</Text>
      <Text>, </Text>
      <Text Style="AllCaps">Parsley</Text>
      <Text>, and </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> sit around the lit firefly herd. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="8aef17df-1ba0-4b0f-8dc1-fb95687a52cd">
      <Text>Parsley</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0323cf53-4a38-4c61-a42e-1a210cb84e8e">
      <Text>So... anyone got a fun game?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e395b6fe-935f-4797-a8c0-149f225d6291">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="47b5b884-eed3-4afa-a92f-b899b6b54798">
      <Text>Games are so lame, lil herb. How ‘bout ghost plant stories?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74fff9de-b60c-4da7-aa4c-0a8574c5faee">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="47c293c3-b99e-45ec-bea3-c8e862784847">
      <Text>Parsley’s too </Text>
      <Text AdornmentStyle="-1">widdle</Text>
      <Text> to hear any of-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3aff0a8a-6312-4b24-9fbe-1e602d351eb0">
      <Text>Parsley</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cf5e30bd-e14b-4ae2-a036-19d60847f436">
      <Text>Ghosts don’t scare me.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bb03f80-9af8-49eb-a713-be578d82aa6f">
      <Text Style="AllCaps">Bombus</Text>
      <Text> in a ghost cloak pops out behind </Text>
      <Text Style="AllCaps">Parsley</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="e3f2dac2-e27f-4c43-8e45-79c1ea937838">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="b2eda935-c644-4c04-82a2-4fdb2cdf9fbc">
          <Text>BombUS</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="4fbe0cd9-fece-4bac-85e6-ccb7fe52369d">
          <Text AdornmentStyle="-1">Booooooozzzzzzzz</Text>
          <Text>!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="9467a6fb-7a92-4148-b306-1bc7b5405242">
          <Text>Parsley &amp; Pyrus</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="93fd8842-e639-4986-9ba5-ef87cc506a25">
          <Text AdornmentStyle="-1">Ahhhhhhhhhhhh</Text>
          <Text>!!!!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="ffc9af41-7a2c-4a70-9d4c-5a262a3adb87">
      <Text Style="AllCaps">Rau</Text>
      <Text> high-fives </Text>
      <Text Style="AllCaps">Bombus</Text>
      <Text>’s antenna.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9e004cd6-4623-4475-a1b3-0e7edf505d07">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e365962c-0d1d-44d4-aeb8-8f40e40eaf43">
      <Text>What’s bugging you, son?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="67585c08-6d35-4c24-9080-0887232062e5">
      <Text AdornmentStyle="-1" Style="AllCaps">Oci</Text>
      <Text> joins in, with CO2-mallow sticks in hand. </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> nabs one.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="282a8978-32e4-4aa9-a208-bc8f7182c3df">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="d5783735-61a2-4a86-aee0-b44b852b0948">
          <Text AdornmentStyle="-1">Oci</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="6c1778d4-8a57-4f63-868b-09add1f4d514">
          <Text>CO2-mallows, anyone?</Text>
        </Paragraph>
        <Paragraph Type="Character" id="e38d9464-2563-4b11-b6d4-469e2215a83a">
          <Text>PYruS</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="f0c762a5-6dc6-4684-901d-b6ae8f6e3b7d">
          <Text>Don’t mind if I do!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="c7991175-8531-4c41-a2bc-10bcf7aca995">
      <Text Style="AllCaps">Rau</Text>
      <Text> takes one but denies </Text>
      <Text Style="AllCaps">Parsley</Text>
      <Text>’s.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe217f78-88bd-499f-b4a8-a1bf29a09214">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="df0824bd-affd-4c1c-9897-dd8d1a1697ac">
      <Text>No CO2-mallows at midnight. It’s basically poison.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b9aca2de-9b3c-40aa-a6a1-8678c8c1b83d">
      <Text Style="AllCaps">Bella Donna</Text>
      <Text>, a nightshade, walks by.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="01614347-227c-4134-ae7c-d095fa46158b">
      <Text>Bella Donna</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1232a9da-1f76-4c3d-a045-cbf619b8af87">
      <Text>Rude. I’m toxic. Not poisonous.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72d408f4-cf75-45d8-a35d-3d84fedd7141">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="39395faf-4bb0-4124-9ccf-81c4113ca6ce">
      <Text>Sorry for the mix up, Bella. Mallows give Parsley a stoma ache.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="de9da29a-9a96-46c0-8051-dfe14c4b2b74">
      <Text>BellA DONNA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a9fa927d-3554-4862-8deb-b4cae77e376f">
      <Text>That, they do.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cff5e240-ba2b-4aef-b61c-672861c3ae71">
      <Text>22-minute episode summary: Rau fails as a Fresh Ground camper and Piper Bell dismisses her as a creative </Text>
      <Text AdornmentStyle="-1">salonist</Text>
      <Text>. Another camper scares off the fireflies and the herd somehow sets fire to the campgrounds. Fresh Ground gets burnt down but not before Rau, Parsley, Pyrus, Bombus, and </Text>
      <Text AdornmentStyle="-1">Oci</Text>
      <Text> get the community together. Piper wants to go down with their “ship.” Piper’s signature number is “Grow a vine or get left behind” and Rau’s number is “Fresh Ground.”</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Scene Heading" id="4961b93b-3090-4ad9-9186-16e68580a352">
      <SceneProperties Length="1/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Int. Fresh Ground Barn - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="648b9a97-87ac-446c-864b-6213406a5937">
      <Text Style="AllCaps">Rau</Text>
      <Text> runs into the flaming barn. She finds </Text>
      <Text Style="AllCaps">Piper</Text>
      <Text> is giving up.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Scene Heading" id="0ec17380-22a5-477f-b68b-1487a307a74a">
      <SceneProperties Length="4/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PIPER BELL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Fresh Ground Barn - MomENTS LATER</Text>
    </Paragraph>
    <Paragraph Type="Action" id="82cbe3cd-426c-49a8-b410-cdf3c1aeb768">
      <Text>The barn collapses, causing the </Text>
      <Text Style="AllCaps">campers</Text>
      <Text> to cry and weep.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a434d68a-e1d5-4953-a689-82f5dd40173a">
      <Text>PaRSLEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d6e0d1cf-d5a6-470d-a1f2-af196b30b13d">
      <Text Style="Italic">Me</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Mom”)</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="97e681b8-5d3f-4c7d-9c31-928ab95c9454">
      <Text>From the smoke of the collapsed barn, </Text>
      <Text Style="AllCaps">Rau</Text>
      <Text> carries </Text>
      <Text Style="AllCaps">Piper</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="97e681b8-5d3f-4c7d-9c31-928ab95c9454">
      <Text>The </Text>
      <Text Style="AllCaps">campers</Text>
      <Text> rejoice.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e4a380e7-7d5b-4bc5-be2b-3161794170f3">
      <Text>PiPER BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="deb176a6-c9dc-452b-9d03-211fe838df8b">
      <Text>Why? After grounding your hopes into spice, you still came back for me...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a412502-5630-428d-b3ed-b1b33527f9c4">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ad3612cf-003c-4022-b0a0-42e7184e0b4c">
      <Text>Nothing makes me more hopeful... than getting my deposit back.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bf294467-ef08-4c72-835d-9584596c7fff">
      <Text Style="AllCaps">Piper</Text>
      <Text> rolls their eyes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5f574bb8-48bb-4269-b341-24bd696a2ce9">
      <Text>The </Text>
      <Text Style="AllCaps">campers</Text>
      <Text> extinguish the remaining fire. The windy smoke transitions to...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Scene Heading" id="9f7f7d98-4b88-4f7f-a1e6-2120b9016d1b">
      <SceneProperties Length="6/8" Page="6" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PIPER BELL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Fresh Ground FireFly Circle - Dawn</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7b96fe27-0bd1-40a0-a8eb-da8f186f4deb">
      <Text>...</Text>
      <Text Style="AllCaps">Bombus</Text>
      <Text> buzz-napping in the pit with a flashlight still taped to their stinger, flickering as the battery dies. Around them are charred barns and giant mushrooms.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="96a198f0-8e54-4145-900b-e8a5cb674f64">
      <Text Style="AllCaps">Rau</Text>
      <Text> walk beside </Text>
      <Text Style="AllCaps">Piper</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7761ae27-7d95-47a1-bfe3-13b65d8ed58b">
      <Text>PiPER BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8cfa0f80-f45c-4145-a25f-ef6f428d6583">
      <Text>Ding dong, it’s going to be real quiet for a long time at Fresh Ground...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9d09712c-c879-45c6-bed7-6dc5318960f5">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ab048679-cbbe-40a8-8dd5-5e895c8ac790">
      <Text>Ashes are old ground made fresh.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1b73710d-6085-43aa-85cc-77c7a90a96b1">
      <Text>Piper Bell</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="57a0c45c-63f6-4e7a-b843-039ce5f85c3b">
      <Text>Try not to burn out, cilantro.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7585478e-8df0-48e8-8917-bf27737ce2fe">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32c743a8-5295-4e8a-8504-dea1dd98cc39">
      <Text>Whether I end up spice or ash, a mother’s soul can never be crushed.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="76dd0732-052c-4799-adc8-4222e6039e31">
      <Text Style="AllCaps">Parsley</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> hop in the pit and kick ash at one another.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="a22afc56-ca33-43fd-aed9-65c7164985b0">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="38624005-f7fb-4101-b73d-c90172933bbb">
          <Text>PARSLEY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="8b9e2a29-8557-4d63-af9b-cd161c50b6fd">
          <Text>Like spice, pear?!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="a61ae9ad-8ab4-46f8-b733-51f3c344a2b4">
          <Text>PyRUS</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="38e4ec1d-da4f-4656-8b55-a981c2c7e6e0">
          <Text>Eat my ash, herb!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="af39ef17-4371-4684-b41e-b85e59a042bb">
      <Text Style="AllCaps">Bombus</Text>
      <Text> is startled awake. They hover and barf honey on </Text>
      <Text Style="AllCaps">Rau</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a09b3131-db3f-4a86-b390-8e0c2aa2c791">
      <Text>Rau</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c179a526-cbbd-47f7-802e-501d3f5850f2">
      <Text>You all are grounded!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4c084150-b703-4c0a-81af-4298195df1d8">
      <Text>As ashes get dispersed by </Text>
      <Text Style="AllCaps">Parsley</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>’s feet, the pit unveils the credits and photos taken throughout the episode, and from Fresh Ground Pepper’s BRB Retreat 2025 Week 3.</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="End of Act" id="a3172081-1aa2-4f43-8d7a-8ffcbf054f4c">
      <Text>End of the Plot

Credits</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d4117d77-ca6f-4a59-9a61-282143bf9738">
      <Text Style="Bold+AllCaps">Dedication</Text>
      <Text>: </Text>
      <Text Style="Bold+AllCaps">Dedicated to Fresh Ground Pepper Brb Retreat 2025 Week 3 - Left to Right: David, Celine, </Text>
      <Text AdornmentStyle="-1" Style="Bold+AllCaps">Maiya</Text>
      <Text Style="Bold+AllCaps">, Maguire, Libby, Katie, Josephine, Neeta, Michael. + Andrew, Andrew, Ben, Cristina, Ernie, Jaclyn, Little Pond</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="End of Act" id="a3172081-1aa2-4f43-8d7a-8ffcbf054f4c">
      <Text>
</Text>      <Picture Height="351" Id="761476a3-8307-4276-b523-d92d07eddff3" Width="468"/>
    </Paragraph>
    <Paragraph Type="New Act" id="ff88514a-6c5e-48ff-829d-272a2172f817"/>
    <Paragraph Type="Character" id="498ae86e-8323-461e-8faf-6a730331c0f6">
      <Text Style="AllCaps+Strikeout">PipER BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e17e0cce-8b43-4ff5-95ef-2809ce202fd9">
      <Text Style="Strikeout">But time nears crushing my soul to oblivion.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c02f8d59-998c-46c5-a76c-98b29c335505">
      <Text Style="AllCaps+Strikeout">Parsley</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e7c82d4d-10f4-42bf-8886-033b0a2f2aef">
      <Text Style="Strikeout">If you tell yours, </Text>
    </Paragraph>
    <Paragraph Type="Character" id="290aefc9-2d56-4877-bcd3-9636057267b6">
      <Text Style="AllCaps+Strikeout">Piper Bell</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="abd5ef8a-7129-4bd2-a476-08a33b53898b">
      <Text Style="Strikeout">Werewolf Spider</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4d22eb3-f659-4389-9a47-044bdef2c0c0">
      <Text Style="AllCaps+Strikeout">PipER BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="37845276-bc99-4197-bd71-7d839a67cff5">
      <Text Style="Strikeout">Grow a vine or get left behind.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d97f4b87-619e-478e-a0ec-80067d4d767d">
      <Text Style="AllCaps+Strikeout">Rau</Text>
    </Paragraph>
    <Paragraph Type="Character" id="41c59b77-a9d1-4a4f-bd4a-0367cf6e8b7f">
      <Text Style="AllCaps+Strikeout">PiPER BELL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42b2c6d5-cf05-432b-bbae-7e4f9f740577">
      <Text Style="Strikeout">I’ve build Fresh Ground from the ground up. Now it’s coming down!</Text>
    </Paragraph>
  </Content>

