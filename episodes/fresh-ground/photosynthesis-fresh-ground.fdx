        </Paragraph>
        <Paragraph Type="Dialogue" id="5cffc93f-8659-4912-8bcc-4cf526fc10dc">
          <Text Style="AllCaps">Off key</Text>
        </Paragraph>
        <Paragraph Type="Character" id="842346e2-43ae-4285-a759-0694e4a4a0c3">
          <Text>Campers</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="de169340-6701-4bce-9520-3cee76385938">
          <Text Style="AllCaps">Do Re Me Fa Sol La </Text>
          <Text AdornmentStyle="-1" Style="AllCaps">ti</Text>
          <Text Style="AllCaps"> Do</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="dcde80fd-0f5a-4f48-bd8f-06d8cb4d71ce">
      <Text Style="AllCaps">Piper</Text>
      <Text> marches the group into...</Text>
    </Paragraph>
