  <ListItems>
    <ListItem Color="#8F8FC3C36A6A" Id="d6cdfd18-af64-4c98-956a-dbe62404ac19" Title="PHOTOSYNTHESIS BEAT BOARD" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="20" Style="Bold+Italic">Photosynthesis</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="20" Style=""> is a plant-based animated musical comedy set in a world inhabited by photogenic plants, where a cilantro and salon owner named Rau Ram tries to earn her green card in a garden that does not welcome her, her son Parsley, or other transplants.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8F8FC3C36A6A" Id="af858087-9994-459a-8470-ab98ce87dd18" Title="Theme Stated" Type="Beat">
      <SubordinateTo Length="0.500" Level="Outline 2" Number="4.500" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">"A green card ain't green on the other side." - Malus Crabapple</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Rau believes a green card would grant her a place in the nation's soil. It can be as lonesome as not having one. Her photos are just her and her son now, but as they better the community, she will learn what it means to belong.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8888CACAB8B8" Id="0805bc7e-6baa-4fc1-a517-394bc531f4b8" Title="Business is Booming" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Though Rau bombed her pitch to the investors cause Parsley showed up in a bad state due to Pyrus, </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Salontro</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style=""> thrives from public empathy which she sees as pity. It catches the attention of </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Rhizo</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFFFFFFFFF" Id="b331a149-4a45-41d9-bd9c-686dfcc9c95a" Title="Opening Image" Type="Beat">
      <SubordinateTo Length="1.000" Level="Outline 2" Number="0.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="12" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">A lonely photo and immigration case file of Rau Ram, an expectant mother on her way to Dirty City, Woodwork.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFFFFFFFFF" Id="cf3bd14f-9452-448e-b518-d172b9f85950" Title="Midpoint" Type="Beat">
      <SubordinateTo Length="0.500" Level="Outline 2" Number="54.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Rau does this summer solstice retreat to get on Malus’s good side in buying Salontro. While on the retreat with Malus, she learns about Malus being kicked out by their parents for being queer and how they found a home in FigLeaf and their experience with immigrants. Malus gifts the deed to Salontro at no charge.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8F8FC3C36A6A" Id="c0788144-0e1d-492e-864a-573c2a6dab28" Title="Bad Guys Close In" Type="Beat">
      <SubordinateTo Length="20.000" Level="Outline 1" Number="54.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Parsley sneaks out. Pyrus has an unlawful rave at </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">FigLeaf</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style=""> that leads to Parsley’s hospitalization and their arrest. Dirty City shuts down </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">FigLeaf</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">.  Hoping to keep the family integrity, Rau decides not to stick up for Malus and blames their community for "misleading" her son.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFA0A0A0A0" Id="6e9f7e97-9b42-4557-a237-3859abee3a60" Title="Cantaloupe Outlets - Crop Top" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
      </Content>
    </ListItem>
    <ListItem Color="#8F8FC3C36A6A" Id="a1f2fc60-174f-467c-bbe0-465aa70b5604" Title="Dark Night of the Soul" Type="Beat">
      <SubordinateTo Length="10.000" Level="Outline 1" Number="74.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Parsley runs away with Pyrus to their hometown of Mt. Woodwork. No one will help even a Woodwork citizen find her son. Rau is alone (“A green card ain't green on the other side”).</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8F8FC3C36A6A" Id="bf677f4f-1f28-40cc-bb33-101f89291589" Title="Finale" Type="Beat">
      <SubordinateTo Length="25.000" Level="Outline 1" Number="84.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">In a city auction, Rau almost wins FigLeaf’s domain, but Dandy Lyon Estate outbids. Rau squats on the premises, halting the demolition. She gains public support but is alone in a water-hunger strike. Secretary of Garden Security Rhizo and their Transplant Service Officers revoke Rau’s green card. Seeing the news, Parsley worries. He returns, making Rau leave her post. FigLeaf gets bulldozed. Rhizo chases Rau into Salontro, but Pyrus traps Rhizo in a tanning bed. Changed by its magic, Rhizo threatens the developers with legal action for exploitations of transplants. Rau knows she’ll have to wait another dozen years for her green card to be reconsidered. Malus builds Fig Palace. She uses her savings to create an internship for Pyrus.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8F8FC3C36A6A" Id="efdf52b4-357c-4cf9-a53f-93694347c667" Title="Fun and Games " Type="Beat">
      <SubordinateTo Length="25.000" Level="Outline 1" Number="29.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Overtime, Rau saves enough to purchase </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Salontro</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">. Parsley seems queer and weird to Rau. Malus asks Rau to come to their summer solstice retreat. Parsley opens up and asks to hang out with Pyrus as friends in Cantaloupe Outlets. Rau receives her green card in the mail. She cannot hold this news any longer and goes to see Parsley. She finds Parsley and Pyrus wearing crop tops which makes her lash out.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFFFFFFFFF" Id="63df4ed7-1dc0-48e2-94a8-646981b907df" Title="All Is Lost" Type="Beat">
      <SubordinateTo Length="0.500" Level="Outline 2" Number="74.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Rau keeps </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Salontro</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style=""> salon, but her son Parsley won’t speak to her. She loses her regulars and lives on her savings.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFFFFFFFFF" Id="53007db0-0ae0-44dd-8f67-0b9d618d3293" Title="Break into Three" Type="Beat">
      <SubordinateTo Length="0.500" Level="Outline 2" Number="84.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">On a calendar, Rau looks at past photos of her and Parsley. It’s been a photo of her alone these past many days. She finds the photobooth photo of Parsley and Pyrus. It’s the happiest Parsley has ever been.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8F8FC3C36A6A" Id="fc17dacc-d360-4392-a7bf-8e82851f1c40" Title="Setup" Type="Beat">
      <SubordinateTo Length="9.000" Level="Outline 1" Number="0.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Rau Ram, a cilantro and expectant mother, emigrates to Dirty City. She could not find a home for her salon business. However, Malus, a nightclub owner and landlord, offers her their spare plot of land. The difference between them is night and day for the nightclub owner and salon owner. She soon has a son named Parsley.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFFFFFFFFF" Id="aa81d714-1855-4e03-827f-d4ed055fdb43" Title="Catalyst" Type="Beat">
      <SubordinateTo Length="0.500" Level="Outline 2" Number="12.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">After a dozen years, Rau’s green card application is finally up for review. It comes at a time when more “invasive species” are forced out of Woodwork. She’s only able to stay in this garden because her son is a natural born citizen. With a green card, she can legally own </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Salontro</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style=""> and get it off Malus’s hand. It's April. She's need to get a green card before summer ends or she'll be uprooted when the Weed Out Act is ratified.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8F8FC3C36A6A" Id="c45c025a-231f-4b3d-9d9a-198b62fd969d" Title="Debate" Type="Beat">
      <SubordinateTo Length="12.000" Level="Outline 1" Number="12.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Pyrus, a pear suspended from their conservatory, visits town and stays with their </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">unty</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style=""> Malus. They befriend the well-behave Parsley. Rau sees Pyrus as a bad influence.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFFFFFFFFF" Id="c138bf8b-af26-4242-b5f1-e398e6e4140f" Title="Break into Two " Type="Beat">
      <SubordinateTo Length="0.500" Level="Outline 2" Number="24.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Rau could never save up when paying rent. However, Malus strikes a deal that they won’t charge them if Parsley is Pyrus’s school tutor.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFFFFFFFFF" Id="321b7d69-34fa-4004-99b8-5e7b8e191ff1" Title="Final Image" Type="Beat">
      <SubordinateTo Length="0.500" Level="Outline 2" Number="108.500" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">A group photo of Rau surrounded by those who love her.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFA0A0A0A0" Id="3dc6360f-ef65-40ec-b666-8dbe3c882951" Title="Pyrus at Parsley's Ceremony" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Pyrus makes a ruckus at the elementary school, where Parsley has a speech. Pyrus realizes Parsley is sheltered.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8888CACAB8B8" Id="cfa9cadc-3458-4f84-9876-4499b1dbd843" Title="Malus invites Rau to Retreat" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">To build trust in Pyrus, Malus invites Rau to their annual summer solstice retreat which she initially is hesitant of.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFFFFFFFFF" Id="2cee6265-aa8b-438d-a042-5d3e9648dd76" Title="B Story " Type="Beat">
      <SubordinateTo Length="0.500" Level="Outline 2" Number="29.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Rau needs all hands on deck to save up to purchase </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Salontro</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">, while Parsley plays hooky with Pyrus and does everything they can to hide their adventures.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8F8FC3C36A6A" Id="488a3e71-bafb-4e40-96cf-14dd69a7313f" Title="Act 1 (Photosyn-Thesis)" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">World before the story.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFFFFFFFFF" Id="61e27ea7-b010-4635-ab47-bb4461c0131c" Title="Act 2 (Anti-PS-thesis)" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="15" Style="">Bizarro version of the world in Act 1.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#8F8FC3C36A6A" Id="ffeefb6d-9d22-44ea-b458-5a5dfe417f20" Title="Act 3 (Photo-Synthesis)" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">The worlds from Act 1 and Act 2 are merged in some way.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#C0C0C0C0C0C0" Id="7448a142-e02e-43d1-be10-96fefbc9b6b1" Title="Break into Two (reminder)" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Act Two, that is; it is where we leave the "Thesis" world behind and enter the upside-down "Anti-thesis" world of Act Two. The hero makes a choice — and his/her journey begins.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFA0A0A0A0" Id="53f63bdb-eae7-4691-a6af-505d61eb5c7a" Title="Pyrus is a lousy mentee" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Parsley tries to tutor Pyrus.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#FFFFA0A0A0A0" Id="8ec2d26c-be1b-4553-b18e-70b89c00ba76" Title="The Herbivores Reality Show" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Rau jokingly says it's easier to get on this Shark Tank-</Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">esque</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style=""> business reality show than a green card. She is right.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#EFEFA4A46262" EndCap="None" EndPoint="b331a149-4a45-41d9-bd9c-686dfcc9c95a" FrontCap="Arrow" Id="489961d3-54ab-40fb-8d3d-a31a77b53aad" StartPoint="fc17dacc-d360-4392-a7bf-8e82851f1c40" Type="PeerLink"/>
    <ListItem EndCap="None" EndPoint="3dc6360f-ef65-40ec-b666-8dbe3c882951" FrontCap="None" Id="f5625f45-86b2-42ba-910f-43cdb028debb" StartPoint="efdf52b4-357c-4cf9-a53f-93694347c667" Type="PeerLink"/>
    <ListItem Color="#EFEFA4A46262" EndCap="None" EndPoint="af858087-9994-459a-8470-ab98ce87dd18" FrontCap="None" Id="e1cfa436-41fe-4c7c-9920-2031d522650a" StartPoint="fc17dacc-d360-4392-a7bf-8e82851f1c40" Type="PeerLink"/>
